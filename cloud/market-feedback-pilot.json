{
  "kind": "Codex Cloud team collaboration environment",
  "name": "market-feedback-pilot",
  "description": "团队协作 Cloud Environment｜英国、新加坡、澳洲消费者反馈试点",
  "publication": {
    "shared": {
      "required_workspace_plan": "Enterprise",
      "who_can_use": "target Enterprise workspace",
      "member_permission": "Use Codex in the cloud",
      "maintainer_permission": "Manage workspace environments"
    }
  },
  "repository": {
    "full_name": "peterljlj/market-feedback-cloud-demo",
    "pilot_ref": "main",
    "working_directory": "repository root"
  },
  "runtime": {
    "language": "Python 3",
    "external_dependencies": [],
    "environment_variables": {
      "FEEDBACK_RULES_FILE": "rules/v2.json"
    },
    "network": {
      "policy": "inherit workspace policy",
      "required_repository_provider": "GitHub",
      "vpn_required": false,
      "http_secrets_required": false
    }
  },
  "pilot": {
    "account_verification_participants": 2,
    "workflow_participants": 5,
    "roles": {
      "environment_maintainer": 1,
      "uk_market_reviewer": 1,
      "sg_market_reviewer": 1,
      "au_market_reviewer": 1,
      "regional_reviewer": 1
    },
    "scale_target_participants": [30, 50]
  },
  "acceptance": {
    "rule_version": "v2",
    "rule_fingerprint": "0728e7536859",
    "coverage_case_ids": ["AU-01", "AU-02", "AU-04", "AU-05", "AU-06"],
    "samples": [
      "samples/uk.csv",
      "samples/sg.csv",
      "samples/au-revised.csv"
    ],
    "input_fingerprints": {
      "au-revised.csv": "bdab67962844",
      "sg.csv": "d97206686f60",
      "uk.csv": "8aaba2ca3a35"
    },
    "market_label_counts": {
      "AU": {"availability": 3, "packaging": 3, "refill_compatibility": 5, "scent": 4},
      "SG": {"availability": 5, "packaging": 5, "scent": 5},
      "UK": {"availability": 5, "packaging": 5, "scent": 5}
    }
  }
}
